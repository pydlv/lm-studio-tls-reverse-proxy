DOMAIN=proxy.example.com
ZONE_NAME=example.com
RECORD_IP=192.168.1.10
TARGET_URL=http://127.0.0.1:1234
HOST=0.0.0.0
PORT=8443
TLS_CERT=certs/public/proxy.example.com.fullchain.pem
TLS_KEY=certs/public/proxy.example.com.key

# Export secrets in your shell instead of committing them:
# CF_Token=...
# CF_Zone_ID=...
# CF_Account_ID=...
# ACME_EMAIL=you@example.com
